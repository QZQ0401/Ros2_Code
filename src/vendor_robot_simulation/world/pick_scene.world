<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="grasping_world">

    <!-- Publish /gazebo/model_states for the Planning Scene synchronizer. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>10.0</update_rate>
    </plugin>

    <!-- World gravity is a direct child of <world> in SDF 1.6. -->
    <gravity>0 0 -9.81</gravity>

    <!-- 物理引擎参数 -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- 环境光 -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- 太阳光 -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 地面 -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 工作台 -->
    <model name="work_table">
      <static>true</static>

      <!-- 工作台位置 -->
      <pose>0.0 0.7 0.4 0 0 0</pose>

      <link name="table_link">

        <!-- 碰撞模型 -->
        <collision name="collision">
          <geometry>
            <box>
              <size>2.2 0.8 0.8</size>
            </box>
          </geometry>
        </collision>

        <!-- 可视化模型 -->
        <visual name="visual">
          <geometry>
            <box>
              <size>2.2 0.8 0.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.5 0.3 0.1 1</ambient>
            <diffuse>0.5 0.3 0.1 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- 障碍物1 -->
    <model name="obstacle_box">
      <static>true</static>
      <!-- 放在桌面上方 -->
      <pose>0.2 0.7 0.85 0 0 0</pose>

      <link name="obstacle_link">

        <!-- 惯性参数 -->
        <inertial>
          <mass>0.9</mass>
          <inertia>
            <ixx>0.000083</ixx>
            <iyy>0.000083</iyy>
            <izz>0.000083</izz>
          </inertia>
        </inertial>

        <!-- 碰撞模型 -->
        <collision name="collision">
          <geometry>
            <box>
              <size>0.03 0.55 0.25</size>
            </box>
          </geometry>

          <surface>
            <friction>
              <ode>
                <!-- 增加摩擦力，方便夹爪抓取 -->
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <!-- 可视化模型 -->
        <visual name="visual">
          <geometry>
            <box>
              <size>0.03 0.55 0.25</size>
            </box>
          </geometry>

          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- 待抓取立方体 -->
    <model name="grasp_box">

      <!-- 放在桌面上方 -->
      <pose>0.6 0.7 0.85 0 0 0</pose>

      <link name="box_link">

        <!-- 惯性参数 -->
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.000083</ixx>
            <iyy>0.000083</iyy>
            <izz>0.000083</izz>
          </inertia>
        </inertial>

        <!-- 碰撞模型 -->
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>

          <surface>
            <friction>
              <ode>
                <!-- 增加摩擦力，方便夹爪抓取 -->
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <!-- 可视化模型 -->
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>

          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- Gazebo 默认相机位置 -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>2.5 -2.5 1.8 0 0.35 2.35</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
