<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="grasping_world">

    <!-- Publish /gazebo/model_states for the Planning Scene synchronizer. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>10.0</update_rate>
    </plugin>

    <!-- World gravity is a direct child of <world> in SDF 1.6. -->
    <gravity>0 0 -9.81</gravity>

    <!-- 物理引擎参数 -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- 环境光 -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- 太阳光 -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 地面 -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 工作台 -->
    <model name="work_table">
      <static>true</static>

      <!-- 工作台位置 -->
      <pose>0.0 0.7 0.4 0 0 0</pose>

      <link name="table_link">

        <!-- 碰撞模型 -->
        <collision name="collision">
          <geometry>
            <box>
              <size>2.2 0.8 0.8</size>
            </box>
          </geometry>
        </collision>

        <!-- 可视化模型 -->
        <visual name="visual">
          <geometry>
            <box>
              <size>2.2 0.8 0.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.5 0.3 0.1 1</ambient>
            <diffuse>0.5 0.3 0.1 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- 障碍物1 -->
    <model name="obstacle_box">
      <static>true</static>
      <!-- 放在桌面上方 -->
      <pose>0.2 0.7 0.85 0 0 0</pose>

      <link name="obstacle_link">

        <!-- 惯性参数 -->
        <inertial>
          <mass>0.9</mass>
          <inertia>
            <ixx>0.000083</ixx>
            <iyy>0.000083</iyy>
            <izz>0.000083</izz>
          </inertia>
        </inertial>

        <!-- 碰撞模型 -->
        <collision name="collision">
          <geometry>
            <box>
              <size>0.03 0.55 0.25</size>
            </box>
          </geometry>

          <surface>
            <friction>
              <ode>
                <!-- 增加摩擦力，方便夹爪抓取 -->
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <!-- 可视化模型 -->
        <visual name="visual">
          <geometry>
            <box>
              <size>0.03 0.55 0.25</size>
            </box>
          </geometry>

          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- 待抓取立方体 -->
    <model name="grasp_box">

      <!-- 放在桌面上方 -->
      <pose>0.6 0.7 0.85 0 0 0</pose>

      <link name="box_link">

        <!-- 惯性参数 -->
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.000083</ixx>
            <iyy>0.000083</iyy>
            <izz>0.000083</izz>
          </inertia>
        </inertial>

        <!-- 碰撞模型 -->
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>

          <surface>
            <friction>
              <ode>
                <!-- 增加摩擦力，方便夹爪抓取 -->
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <!-- 可视化模型 -->
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>

          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- Gazebo 默认相机位置 -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>2.5 -2.5 1.8 0 0.35 2.35</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>



    <!-- 固定工作区深度相机 -->
    <model name="workspace_camera">
      <static>true</static>

      <!-- 位置后面根据实际视野调整 -->
      <pose>0.3 2 1.5 0 0.534 -1.57079632679</pose>

      <link name="workspace_camera_link">

        <visual name="camera_visual">
          <geometry>
            <box>
              <size>0.08 0.04 0.03</size>
            </box>
          </geometry>
        </visual>

        <sensor name="workspace_depth_camera" type="depth">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>

          <camera>
            <horizontal_fov>1.57</horizontal_fov>

            <image>
              <width>640</width>
              <height>480</height>
              <format>B8G8R8</format>
            </image>

            <depth_camera/>

            <clip>
              <near>0.10</near>
              <far>5.0</far>
            </clip>
          </camera>

          <plugin name="workspace_depth_camera_controller" filename="libgazebo_ros_camera.so">

            <ros>
              <namespace>/</namespace>
            </ros>

            <camera_name>workspace_camera</camera_name>

            <frame_name>
              workspace_camera_optical_frame
            </frame_name>

            <min_depth>0.10</min_depth>
            <max_depth>5.0</max_depth>

          </plugin>
        </sensor>

      </link>

      <link name="workspace_camera_optical_frame">
        <pose>
          0 0 0
          -1.57079632679 0 -1.57079632679
        </pose>

      </link>
      <joint
        name="workspace_camera_optical_joint"
        type="fixed">

        <parent>workspace_camera_link</parent>
        <child>workspace_camera_optical_frame</child>

      </joint>
    </model>


    <!-- ====================================================== -->
    <!-- 第二台固定工作区深度相机：从 +X 侧倾斜俯视工作区       -->
    <!-- 位置: (1.4, 0.7, 1.5), 朝向 -X，并向下俯视约 25 deg    -->
    <!-- ====================================================== -->
    <model name="workspace_camera_2">
      <static>true</static>

      <!--
        Gazebo camera 的 +X 为前向。
        yaw = pi 使相机朝向 world -X；
        pitch = 0.434 rad 使视线向下倾斜约 25 deg。
      -->
      <pose>1.4 0.7 1.5 0 0.434 3.14159265359</pose>

      <link name="workspace_camera_2_link">

        <visual name="camera_visual">
          <geometry>
            <box>
              <size>0.08 0.04 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.2 0.8 1</ambient>
            <diffuse>0.1 0.2 0.8 1</diffuse>
          </material>
        </visual>

        <sensor name="workspace_depth_camera_2" type="depth">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>

          <camera>
            <horizontal_fov>1.047</horizontal_fov>

            <image>
              <width>640</width>
              <height>480</height>
              <format>B8G8R8</format>
            </image>

            <depth_camera/>

            <clip>
              <near>0.10</near>
              <far>5.0</far>
            </clip>
          </camera>

          <plugin name="workspace_depth_camera_2_controller"
                  filename="libgazebo_ros_camera.so">

            <ros>
              <namespace>/</namespace>
            </ros>

            <camera_name>workspace_camera_2</camera_name>

            <frame_name>
              workspace_camera_2_optical_frame
            </frame_name>

            <min_depth>0.10</min_depth>
            <max_depth>5.0</max_depth>

          </plugin>
        </sensor>

      </link>

      <!-- optical frame: X right, Y down, Z forward -->
      <link name="workspace_camera_2_optical_frame">
        <pose>
          0 0 0
          -1.57079632679 0 -1.57079632679
        </pose>
      </link>

      <joint name="workspace_camera_2_optical_joint" type="fixed">
        <parent>workspace_camera_2_link</parent>
        <child>workspace_camera_2_optical_frame</child>
      </joint>

    </model>


    <!-- ====================================================== -->
    <!-- 抓取物放置筐：位于工作台左侧                           -->
    <!-- 外部尺寸约 0.40 x 0.32 m，壁高 0.16 m                  -->
    <!-- 桌面高度 z = 0.8，因此筐模型原点放在桌面处             -->
    <!-- ====================================================== -->
    <model name="placement_bin">
      <static>true</static>

      <!-- 放在桌面左侧，避开当前抓取物和中间障碍物 -->
      <pose>-0.65 0.7 0.8 0 0 0</pose>

      <link name="placement_bin_link">

        <!-- 底板 -->
        <collision name="base_collision">
          <pose>0 0 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>0.40 0.32 0.03</size>
            </box>
          </geometry>
        </collision>

        <visual name="base_visual">
          <pose>0 0 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>0.40 0.32 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.35 0.75 1</ambient>
            <diffuse>0.15 0.35 0.75 1</diffuse>
          </material>
        </visual>

        <!-- +Y 侧壁 -->
        <collision name="wall_pos_y_collision">
          <pose>0 0.1475 0.11 0 0 0</pose>
          <geometry>
            <box>
              <size>0.40 0.025 0.16</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_pos_y_visual">
          <pose>0 0.1475 0.11 0 0 0</pose>
          <geometry>
            <box>
              <size>0.40 0.025 0.16</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.35 0.75 1</ambient>
            <diffuse>0.15 0.35 0.75 1</diffuse>
          </material>
        </visual>

        <!-- -Y 侧壁 -->
        <collision name="wall_neg_y_collision">
          <pose>0 -0.1475 0.11 0 0 0</pose>
          <geometry>
            <box>
              <size>0.40 0.025 0.16</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_neg_y_visual">
          <pose>0 -0.1475 0.11 0 0 0</pose>
          <geometry>
            <box>
              <size>0.40 0.025 0.16</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.35 0.75 1</ambient>
            <diffuse>0.15 0.35 0.75 1</diffuse>
          </material>
        </visual>

        <!-- +X 侧壁 -->
        <collision name="wall_pos_x_collision">
          <pose>0.1875 0 0.11 0 0 0</pose>
          <geometry>
            <box>
              <size>0.025 0.32 0.16</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_pos_x_visual">
          <pose>0.1875 0 0.11 0 0 0</pose>
          <geometry>
            <box>
              <size>0.025 0.32 0.16</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.35 0.75 1</ambient>
            <diffuse>0.15 0.35 0.75 1</diffuse>
          </material>
        </visual>

        <!-- -X 侧壁 -->
        <collision name="wall_neg_x_collision">
          <pose>-0.1875 0 0.11 0 0 0</pose>
          <geometry>
            <box>
              <size>0.025 0.32 0.16</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_neg_x_visual">
          <pose>-0.1875 0 0.11 0 0 0</pose>
          <geometry>
            <box>
              <size>0.025 0.32 0.16</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.35 0.75 1</ambient>
            <diffuse>0.15 0.35 0.75 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


  </world>
</sdf>