<?xml version="1.0"?>
<!-- Mobile G4: differential-drive base plus a Link6-mounted depth camera. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="g4_mobile_depth">
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="use_gravity" default="true"/>
  <xacro:arg name="initial_positions_file" default="$(find vendor_robot_description)/config/initial_positions.yaml"/>
  <xacro:arg name="controllers_file" default="$(find vendor_robot_simulation)/config/controllers.yaml"/>

  <xacro:property name="prefix" value="$(arg prefix)"/>
  <xacro:property name="initial_positions_file" value="$(arg initial_positions_file)"/>
  <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_separation" value="0.52"/>

  <!-- The pure arm model has base -> base_link but no world joint. -->
  <xacro:include filename="$(find vendor_robot_description)/urdf/g4.model.xacro"/>

  <xacro:macro name="arm_gazebo_properties" params="link_name">
    <gazebo reference="${prefix}${link_name}">
      <material>Gazebo/White</material><self_collide>false</self_collide><gravity>$(arg use_gravity)</gravity>
    </gazebo>
  </xacro:macro>
  <xacro:arm_gazebo_properties link_name="base_link"/>
  <xacro:arm_gazebo_properties link_name="Link1"/>
  <xacro:arm_gazebo_properties link_name="Link2"/>
  <xacro:arm_gazebo_properties link_name="Link3"/>
  <xacro:arm_gazebo_properties link_name="Link4"/>
  <xacro:arm_gazebo_properties link_name="Link5"/>
  <xacro:arm_gazebo_properties link_name="Link6"/>
  <xacro:arm_gazebo_properties link_name="gripper_base_link"/>
  <xacro:arm_gazebo_properties link_name="gripper_left_link"/>
  <xacro:arm_gazebo_properties link_name="gripper_right_link"/>
  <xacro:arm_gazebo_properties link_name="gripper_left_finger"/>
  <xacro:arm_gazebo_properties link_name="gripper_right_finger"/>

  <ros2_control name="${prefix}GazeboSystem" type="system">
    <hardware><plugin>gazebo_ros2_control/GazeboSystem</plugin></hardware>
    <xacro:macro name="arm_joint_interface" params="joint_name">
      <joint name="${prefix}${joint_name}">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">${initial_positions[joint_name]}</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:arm_joint_interface joint_name="joint1"/>
    <xacro:arm_joint_interface joint_name="joint2"/>
    <xacro:arm_joint_interface joint_name="joint3"/>
    <xacro:arm_joint_interface joint_name="joint4"/>
    <xacro:arm_joint_interface joint_name="joint5"/>
    <xacro:arm_joint_interface joint_name="joint6"/>
    <!-- The model owns the mimic declaration; Gazebo owns the actuator interface. -->
    <joint name="${prefix}gripper_left_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">${initial_positions['gripper_left_joint']}</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="${prefix}gripper_right_joint">
      <param name="mimic">${prefix}gripper_left_joint</param>
      <param name="multiplier">-1</param>
      <!-- Mimic joints are state-only: gripper_left_joint is the sole actuator. -->
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <!-- The diff-drive Gazebo plugin commands these wheels.  ros2_control only
         exports their state so robot_state_publisher and MoveIt see a complete
         model state. -->
    <joint name="${prefix}left_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="${prefix}right_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="${prefix}caster_swivel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="${prefix}caster_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <robot_param>robot_description</robot_param><robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(arg controllers_file)</parameters><hold_joints>true</hold_joints>
    </plugin>
  </gazebo>

  <xacro:macro name="wheel" params="name y">
    <link name="${prefix}${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
      </inertial>
      <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="${wheel_radius}" length="0.05"/></geometry><material name="black"><color rgba="0.05 0.05 0.05 1"/></material></visual>
      <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="${wheel_radius}" length="0.05"/></geometry></collision>
    </link>
    <joint name="${prefix}${name}_joint" type="continuous">
      <parent link="${prefix}mobile_base_link"/>
      <child link="${prefix}${name}"/>
      <!-- mobile_base_link is elevated; keep wheel contact at world z=0. -->
      <origin xyz="0 ${y} ${wheel_radius / 2.0}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- A massless root prevents KDL/robot_state_publisher from discarding the
       mobile-base inertia. Gazebo's odom TF targets mobile_base_link. -->
  <link name="${prefix}base_footprint"/>
  <link name="${prefix}mobile_base_link">
    <inertial>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <mass value="45.0"/>
      <inertia ixx="1.20" ixy="0" ixz="0" iyy="1.80" iyz="0" izz="2.40"/>
    </inertial>
    <visual><origin xyz="0 0 0.10"/><geometry><box size="0.70 0.52 0.20"/></geometry><material name="base_blue"><color rgba="0.10 0.20 0.40 1"/></material></visual>
    <collision><origin xyz="0 0 0.10"/><geometry><box size="0.70 0.52 0.20"/></geometry></collision>
  </link>
  <joint name="${prefix}mobile_base_to_base_footprint" type="fixed">
    <parent link="${prefix}mobile_base_link"/><child link="${prefix}base_footprint"/>
    <origin xyz="0 0 -0.05" rpy="0 0 0"/>
  </joint>
  <gazebo reference="${prefix}mobile_base_link"><material>Gazebo/Blue</material><gravity>$(arg use_gravity)</gravity></gazebo>

  <xacro:wheel name="left_wheel" y="${wheel_separation / 2.0}"/>
  <xacro:wheel name="right_wheel" y="${-wheel_separation / 2.0}"/>
  <!-- Keep all mobile-base links governed by the launch use_gravity argument.
       Without these overrides the wheels inherit world gravity even when the
       rest of the robot is configured with use_gravity:=false. -->
  <gazebo reference="${prefix}left_wheel"><gravity>$(arg use_gravity)</gravity></gazebo>
  <gazebo reference="${prefix}right_wheel"><gravity>$(arg use_gravity)</gravity></gazebo>

  <!-- Rear swivel caster supporting the elevated chassis. -->
  <link name="${prefix}caster_swivel_link">
    <inertial><mass value="0.15"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
  </link>
  <joint name="${prefix}caster_swivel_joint" type="continuous">
    <parent link="${prefix}mobile_base_link"/><child link="${prefix}caster_swivel_link"/>
    <origin xyz="-0.28 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <link name="${prefix}caster_wheel">
    <inertial><mass value="0.4"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.06" length="0.04"/></geometry><material name="caster_black"><color rgba="0.03 0.03 0.03 1"/></material></visual>
    <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.06" length="0.04"/></geometry></collision>
  </link>
  <joint name="${prefix}caster_wheel_joint" type="continuous">
    <parent link="${prefix}caster_swivel_link"/><child link="${prefix}caster_wheel"/>
    <origin xyz="0 0 0.01" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>
  <gazebo reference="${prefix}caster_swivel_link"><gravity>$(arg use_gravity)</gravity></gazebo>
  <gazebo reference="${prefix}caster_wheel"><gravity>$(arg use_gravity)</gravity></gazebo>

  <!-- The arm model's root is base -> base_link. Mount base above the chassis. -->
  <joint name="${prefix}mobile_base_to_robot_base" type="fixed">
    <parent link="${prefix}mobile_base_link"/>
    <child link="${prefix}base"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}depth_camera_link">
    <inertial><mass value="0.12"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    <visual><geometry><box size="0.08 0.04 0.03"/></geometry><material name="camera_black"><color rgba="0.02 0.02 0.02 1"/></material></visual>
    <collision><geometry><box size="0.08 0.04 0.03"/></geometry></collision>
  </link>
  <!-- Camera optical axis is +X of Link6; adjust this fixed origin for the real tool mount. -->
  <joint name="${prefix}link6_to_depth_camera" type="fixed">
    <parent link="${prefix}Link6"/>
    <child link="${prefix}depth_camera_link"/>
    <origin xyz="0.08 0 -0.03" rpy="0 0 0"/>
  </joint>
  <link name="${prefix}depth_camera_optical_frame"/>
  <joint name="${prefix}depth_camera_optical_joint" type="fixed">
    <parent link="${prefix}depth_camera_link"/>
    <child link="${prefix}depth_camera_optical_frame"/>
    <!-- ROS optical frame: X right, Y down, Z forward. -->
    <origin xyz="0.08 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <gazebo reference="${prefix}depth_camera_link">
    <gravity>$(arg use_gravity)</gravity>
    <sensor name="depth_camera_sensor" type="depth">
      <always_on>true</always_on><update_rate>30</update_rate><visualize>false</visualize>
      <camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>B8G8R8</format></image><depth_camera/><clip><near>0.10</near><far>8.0</far></clip></camera>
      <plugin name="depth_camera_controller" filename="libgazebo_ros_camera.so">
        <ros><namespace>/</namespace></ros>
        <camera_name>depth_camera</camera_name>
        <frame_name>${prefix}depth_camera_optical_frame</frame_name>
        <min_depth>0.10</min_depth><max_depth>8.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="mobile_base_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><namespace>/</namespace></ros>
      <left_joint>${prefix}left_wheel_joint</left_joint>
      <right_joint>${prefix}right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation><wheel_diameter>${2.0 * wheel_radius}</wheel_diameter>
      <max_wheel_torque>20.0</max_wheel_torque><max_wheel_acceleration>4.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom><publish_odom_tf>true</publish_odom_tf><publish_wheel_tf>true</publish_wheel_tf>
      <!-- Publish odom -> base_footprint.  The URDF then contributes the
           fixed base_footprint -> mobile_base_link transform, yielding one
           connected TF tree (rather than two parents for mobile_base_link). -->
      <odometry_frame>odom</odometry_frame><robot_base_frame>${prefix}mobile_base_link</robot_base_frame>
    </plugin>
  </gazebo>
</robot>
